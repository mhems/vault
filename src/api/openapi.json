  "components": {
    "schemas": {
      "AddPlayerDto": {
        "required": [
          "playerClassId",
          "accountId",
          "name"
        ],
        "type": "object",
        "properties": {
          "playerClassId": {
            "type": "string",
            "format": "uuid"
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "level": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "uint8",
            "default": 1
          },
          "experience": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "money": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ClassModItemDto": {
        "required": [
          "prefix",
          "id",
          "playerId",
          "modelId",
          "rarityId",
          "level",
          "buyPrice",
          "sellPrice"
        ],
        "type": "object",
        "properties": {
          "prefix": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "playerId": {
            "type": "string",
            "format": "uuid"
          },
          "modelId": {
            "type": "string",
            "format": "uuid"
          },
          "rarityId": {
            "type": "string",
            "format": "uuid"
          },
          "level": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "uint8"
          },
          "buyPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "sellPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "Element": {
        "type": "integer"
      },
      "ElementalDamageChanceDto": {
        "required": [
          "element",
          "damagePerSecond",
          "chance"
        ],
        "type": "object",
        "properties": {
          "element": {
            "$ref": "#/components/schemas/Element"
          },
          "damagePerSecond": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "chance": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "ElementalDamageDto": {
        "required": [
          "element",
          "damagePerSecond"
        ],
        "type": "object",
        "properties": {
          "element": {
            "$ref": "#/components/schemas/Element"
          },
          "damagePerSecond": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "EquipmentItemDto": {
        "required": [
          "id",
          "playerId",
          "modelId",
          "rarityId",
          "level",
          "buyPrice",
          "sellPrice"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "playerId": {
            "type": "string",
            "format": "uuid"
          },
          "modelId": {
            "type": "string",
            "format": "uuid"
          },
          "rarityId": {
            "type": "string",
            "format": "uuid"
          },
          "level": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "uint8"
          },
          "buyPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "sellPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "GrenadeDelivery": {
        "type": "integer"
      },
      "GrenadeItemDto": {
        "required": [
          "damage",
          "blastRadius",
          "fuse",
          "delivery",
          "sticky",
          "childCount",
          "elementalDamage",
          "id",
          "playerId",
          "modelId",
          "rarityId",
          "level",
          "buyPrice",
          "sellPrice"
        ],
        "type": "object",
        "properties": {
          "damage": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "blastRadius": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "fuse": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "delivery": {
            "$ref": "#/components/schemas/GrenadeDelivery"
          },
          "sticky": {
            "type": "boolean"
          },
          "childCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "elementalDamage": {
            "oneOf": [
              {
                "type": "null"
